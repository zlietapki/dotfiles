listener {
    timeout = 600 # in seconds.
    on-timeout = hyprlock
}

{{ if eq .machine "thinkpad" -}}
# приглушить клавиатуру
listener {
    timeout = 60 # seconds
    on-timeout = brightnessctl -sd '*::kbd_backlight' set 0 # save state and turn off keyboard backlight
    on-resume = brightnessctl -rd '*::kbd_backlight' # restore keyboard backlight
}

# приглушить монитор
listener {
    timeout = 5 # seconds
    on-timeout = target=30; max=$(brightnessctl -d intel_backlight m); target_abs=$((max * target / 100)); current=$(brightnessctl -d intel_backlight get); [ "$current" -gt "$target_abs" ] && for i in $(seq "$current" -1000 "$target_abs"); do brightnessctl -qd intel_backlight set "$i"; done
    on-resume = max=$(brightnessctl -d intel_backlight m); current=$(brightnessctl -d intel_backlight get); [ "$current" -lt "$max" ] && for i in $(seq "$current" 1000 "$max"); do brightnessctl -qd intel_backlight set "$i"; done && brightnessctl -qd intel_backlight set "$max"
}
{{ end -}}
