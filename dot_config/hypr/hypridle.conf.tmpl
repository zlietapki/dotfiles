listener {
    timeout = 600 # in seconds.
    on-timeout = hyprlock
}

{{ if eq .machine "thinkpad" -}}
# приглушить клавиатуру
listener {
    timeout = 60 # seconds
    on-timeout = brightnessctl -sd '*::kbd_backlight' set 0 # save state and turn off keyboard backlight
    on-resume = brightnessctl -rd '*::kbd_backlight' # restore keyboard backlight
}

# приглушить монитор
listener {
    timeout = 5 # seconds
    on-timeout = current=$(brightnessctl -d intel_backlight get); [ "$current" -gt 15000 ] && brightnessctl -d intel_backlight set 15000
    on-resume = brightnessctl -d intel_backlight set 100%
}
{{ end -}}
